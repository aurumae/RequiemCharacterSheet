#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mode=()
if [[ "${1:-}" == --strict ]]; then mode=(--strict); shift; fi
if [[ $# -ne 0 ]]; then echo 'Usage: scripts/check-save-contract [--strict]' >&2; exit 2; fi
report_dir=${REQUIEM_REPORT_DIR:-"$PWD/.contract-reports"}
mkdir -p "$report_dir"
exchange_dir=$(mktemp -d "$report_dir/exchange.XXXXXX")
python3 scripts/contract_policy.py "${mode[@]}" --output "$exchange_dir"
export REQUIEM_EXCHANGE_DIR="$exchange_dir"
export REQUIEM_EXCHANGE_PLAN="$exchange_dir/plan.json"
swift_command=${REQUIEM_SWIFT:-swift}
gradle_args=()
if [[ -n "${REQUIEM_GRADLE_CACHE:-}" ]]; then gradle_args+=(--project-cache-dir "$REQUIEM_GRADLE_CACHE"); fi
if [[ -n "${REQUIEM_GRADLE_INIT:-}" ]]; then gradle_args+=(--init-script "$REQUIEM_GRADLE_INIT"); fi
"$swift_command" test --xunit-output "$exchange_dir/swift-tests.xml"
python3 scripts/contract_policy.py --evidence ios --reports "$exchange_dir"/swift-tests*.xml
android/gradlew -p android "${gradle_args[@]}" :core:test :requiem:test :app:testDebugUnitTest "-PexchangeDir=$exchange_dir" "-PcontractPlan=$REQUIEM_EXCHANGE_PLAN"
jvm_reports=${REQUIEM_JVM_REPORT_ROOT:-android/requiem/build}
app_reports=${REQUIEM_APP_REPORT_ROOT:-android/app/build}
python3 scripts/contract_policy.py --evidence android --reports "$jvm_reports"/test-results/test/TEST-*.xml "$app_reports"/test-results/testDebugUnitTest/TEST-*.xml
REQUIEM_CHECK_KOTLIN=1 "$swift_command" test --skip-build --filter readsKotlin --xunit-output "$exchange_dir/swift-consumer-tests.xml"
echo "Exchange passed; reports: $exchange_dir"
